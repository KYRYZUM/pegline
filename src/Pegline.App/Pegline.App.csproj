<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Pegline</AssemblyName>
    <RootNamespace>Pegline.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.2</Version>
    <Product>Pegline</Product>
    <Company>Pegline</Company>
    <Copyright>Copyright (c) 2026 Enes Sarı</Copyright>
    <ApplicationIcon>..\..\assets\brand\pegline.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>Pegline.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\brand\pegline-tray.ico" LogicalName="Pegline.Brand.tray.ico" />
    <EmbeddedResource Include="..\..\assets\brand\pegline-mark.png" LogicalName="Pegline.Brand.mark.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF types win; WinForms is only used for the tray icon and screen metrics. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- MobileCLIP-S2 (scripts/prepare-search-models.ps1). Builds without it run; visual search is then unavailable. -->
    <None Include="..\..\assets\CLIP\*" Link="CLIP\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\CLIP\model-source.json')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Catalogs\*.json" LogicalName="Pegline.Catalog.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pegline.Core\Pegline.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
